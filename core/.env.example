DB_URL=jdbc:postgresql://localhost:5432/core
DB_USER=core
DB_PASSWORD=replace-me
ORCHESTRATOR_URL=http://localhost:8081

# Full realm issuer URL, matching the token's iss claim; omit a trailing slash.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/automaton
KEYCLOAK_AUDIENCE=core
KEYCLOAK_CLIENT_ID=core-service
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
KEYCLOAK_CLIENT_SCOPES=tasks:submit,tasks:read
